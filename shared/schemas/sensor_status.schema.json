{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sensor status message",
  "description": "Retained message on venue/{venue_id}/sensor/{sensor_id}/status. 'offline' is also registered as the sensor's MQTT Last Will.",
  "type": "object",
  "required": [
    "sensor_id",
    "status"
  ],
  "additionalProperties": false,
  "properties": {
    "sensor_id": {
      "type": "string",
      "pattern": "^C[0-9]{2}$"
    },
    "status": {
      "enum": [
        "online",
        "offline"
      ]
    },
    "ts": {
      "type": "number"
    }
  }
}
